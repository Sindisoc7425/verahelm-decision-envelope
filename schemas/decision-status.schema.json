{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verahelm:decision-status:1.0",
  "title": "Verahelm Decision Envelope lifecycle status",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "envelope_id", "state", "observed_at", "issued_at", "expires_at"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "envelope_id": { "type": "string", "pattern": "^de_[a-z0-9_]{8,80}$" },
        "state": { "enum": ["active", "expired", "revoked", "superseded"] },
        "observed_at": { "type": "string", "format": "date-time" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked_at": { "type": "string", "format": "date-time" },
        "superseded_by": { "type": "string", "pattern": "^de_[a-z0-9_]{8,80}$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
